{
  "name": "asumi-plugin-regenerate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Asumi's regenerate action: re-ask the question behind one answer without leaving the session",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
