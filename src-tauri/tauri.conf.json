{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Asumi Agent",
  "version": "2.0.0",
  "identifier": "com.asumi.agent",
  "build": {
    "beforeDevCommand": "node scripts/spawn-dsh.mjs",
    "devUrl": "about:blank",
    "beforeBuildCommand": "pnpm build:renderer",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Cherry Studio",
        "width": 1200,
        "height": 800,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
