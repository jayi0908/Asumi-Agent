{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Asumi Agent",
  "version": "0.1.0",
  "identifier": "com.asumi.agent",
  "build": {
    "beforeDevCommand": "node scripts/spawn-dsh.mjs",
    "devUrl": "http://127.0.0.1:9999/",
    "frontendDist": "./loading"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Asumi Agent",
        "width": 1200,
        "height": 800,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
