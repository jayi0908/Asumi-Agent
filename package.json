{
  "name": "asumi-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Asumi Agent — a desktop AI companion (錦 あすみ) hosted on Tauri 2 and powered by the DeepSeek Harness engine",
  "type": "module",
  "license": "GPL-2.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "postinstall": "node scripts/link-dsh-packages.mjs",
    "dev": "tauri dev",
    "build": "tauri build --config src-tauri/tauri.bundle.conf.json",
    "tauri": "tauri",
    "build:engine": "node scripts/build-engine.mjs",
    "fetch:node": "node scripts/fetch-node.mjs",
    "configure:model": "node scripts/configure-asumi-model.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.5-rc.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "yaml": "^2.8.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@deepseek-ai/dsh-subprocess-local",
      "koffi",
      "node-pty",
      "protobufjs"
    ]
  }
}
